datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum EmploymentType {
  INTERNSHIP
  FULL_TIME
  GRADUATE_PROGRAM
  TRAINEE
}

enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum NotificationType {
  JOB_MATCH
  JOB_EXPIRED
  SYSTEM
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  name               String
  college            String?
  degree             String?
  branch             String?
  gradYear           Int?
  skills             String[]       @default([])
  preferredRoles     String[]       @default([])
  preferredLocations String[]       @default([])
  resumeUrl          String?
  role               UserRole       @default(USER)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  savedJobs          SavedJob[]
  notifications      Notification[]

  @@map("users")
}

model Company {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  website          String
  careerUrl        String
  industry         String
  description      String
  activeJobsCount  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  jobs             Job[]

  @@map("companies")
}

model Job {
  id             String         @id @default(uuid())
  companyId      String
  sourceId       String         @default("official_portal")
  externalJobId  String
  title          String
  description    String
  location       String
  workMode       WorkMode       @default(ONSITE)
  employmentType EmploymentType @default(INTERNSHIP)
  experienceMin  Int            @default(0)
  experienceMax  Int            @default(1)
  category       String
  postedAt       DateTime       @default(now())
  deadline       DateTime?
  sourceUrl      String
  status         JobStatus      @default(ACTIVE)
  contentHash    String
  lastVerifiedAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSkills      JobSkill[]
  savedBy        SavedJob[]

  @@unique([companyId, externalJobId])
  @@index([status, category])
  @@index([location])
  @@index([postedAt])
  @@map("jobs")
}

model Skill {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  category  String?
  jobSkills JobSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model SyncHistory {
  id           String     @id @default(uuid())
  companyId    String
  companyName  String
  status       SyncStatus @default(SUCCESS)
  jobsFetched  Int        @default(0)
  jobsInserted Int        @default(0)
  jobsUpdated  Int        @default(0)
  jobsExpired  Int        @default(0)
  jobsRejected Int        @default(0)
  errorMessage String?
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  logs         SyncLog[]

  @@map("sync_histories")
}

model SyncLog {
  id            String      @id @default(uuid())
  syncHistoryId String
  level         String      @default("INFO")
  message       String
  createdAt     DateTime    @default(now())
  syncHistory   SyncHistory @relation(fields: [syncHistoryId], references: [id], onDelete: Cascade)

  @@map("sync_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
